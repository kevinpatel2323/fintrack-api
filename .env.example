PORT=3000
DATABASE_URL=postgres://user:pass@host:6543/postgres

# ── Passkey (WebAuthn) auth ──────────────────────────────────────────────────
# Display name shown in the authenticator UI.
RP_NAME=Fintrack
# Relying Party ID = the WEB app host (NOT the API host). Dev: localhost.
# Prod: the web Vercel host, e.g. fintrack.vercel.app. Passkeys are bound to
# this value — changing it (e.g. a custom domain) requires re-enrollment.
RP_ID=localhost
# Full web origin(s) allowed, comma-separated. Dev: http://localhost:3001.
# Prod: https://<web-host> (add extra deploy aliases comma-separated).
RP_ORIGIN=http://localhost:3001
# Break-glass token for enrolling the FIRST passkey (and re-enrolling if locked
# out). Use a long random value; rotate it in Vercel to recover access.
SETUP_TOKEN=change-me-to-a-long-random-string
# Absolute session lifetime in minutes (no sliding renewal).
SESSION_TTL_MINUTES=60
