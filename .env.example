PORT=3000
DATABASE_URL=postgres://user:pass@host:6543/postgres
# Max DB connection pool size (TypeORM/pg). Default 3 if unset. Keep this small
# on Supabase's free tier / serverless — the 6543 transaction pooler has limited
# slots and an oversized pool can exhaust them.
DB_POOL_MAX=3

# Skip passkey auth in local dev (never set in production).
AUTH_DISABLED=true

# ── Passkey (WebAuthn) auth ──────────────────────────────────────────────────
# Display name shown in the authenticator UI.
RP_NAME=Fintrack
# Relying Party ID = the WEB app host (NOT the API host). Dev: localhost.
# Prod: the web Vercel host, e.g. fintrack.vercel.app. Passkeys are bound to
# this value — changing it (e.g. a custom domain) requires re-enrollment.
RP_ID=localhost
# Full web origin(s) allowed, comma-separated. Dev: http://localhost:3001.
# Prod: https://<web-host> (add extra deploy aliases comma-separated).
RP_ORIGIN=http://localhost:3001
# Comma-separated CORS allowlist (Access-Control-Allow-Origin), enforced in
# main.ts. If unset, the API reflects any origin. Distinct from RP_ORIGIN (the
# OriginCsrfGuard's CSRF allowlist) — in practice set both to the same web host.
CORS_ORIGIN=http://localhost:3001
# Break-glass token for enrolling the FIRST passkey (and re-enrolling if locked
# out). Use a long random value; rotate it in Vercel to recover access.
SETUP_TOKEN=change-me-to-a-long-random-string
# Absolute session lifetime in minutes (no sliding renewal).
SESSION_TTL_MINUTES=60

# ── Transaction memos (bank SMS from the Fintrack Memos iPhone shortcut) ─────
# 32-byte key that seals each memo's SMS text and location (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it out of the database and mark it Sensitive in Vercel; losing it makes
# stored SMS text unreadable (parsed fields and memos are unaffected).
MEMO_DATA_KEY=
# true lets a paired iPhone read the holder names of named bank accounts by
# their last four digits (GET /api/v1/accounts) and keep them in iCloud Drive
# (Fintrack/account-names.txt), so memo prompts written with no signal show
# "Kevin Patel" instead of "HDFC ••6714". Off by default: a device key is
# otherwise write-only. Replies to its own SMS name the account either way.
MEMO_DEVICE_ACCOUNT_NAMES=
